{
  "manifest_version": 3,
  "name": "Alfred Music Companion",
  "short_name": "Alfred Music",
  "version": "1.6.0",
  "default_locale": "en",
  "description": "GPL-3.0 Companion fork with a local, allowlisted Alfred Native Messaging bridge",
  "permissions": [
    "storage",
    "clipboardWrite",
    "alarms",
    "scripting",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://music.youtube.com/*",
    "https://lrclib.net/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content/bridge.js"
      ],
      "matches": [
        "https://music.youtube.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Alfred Music Companion",
    "default_icon": {
      "16": "alfred-icons/icon16.png",
      "32": "alfred-icons/icon32.png",
      "48": "alfred-icons/icon48.png",
      "128": "alfred-icons/icon128.png"
    }
  },
  "icons": {
    "16": "alfred-icons/icon16.png",
    "32": "alfred-icons/icon32.png",
    "48": "alfred-icons/icon48.png",
    "128": "alfred-icons/icon128.png"
  },
  "commands": {
    "play-pause": {
      "suggested_key": {
        "default": "Alt+Shift+Space"
      },
      "description": "__MSG_cmdPlayPause__"
    },
    "next-track": {
      "suggested_key": {
        "default": "Alt+Shift+Period"
      },
      "description": "__MSG_cmdNext__"
    },
    "previous-track": {
      "suggested_key": {
        "default": "Alt+Shift+Comma"
      },
      "description": "__MSG_cmdPrevious__"
    },
    "toggle-like": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "__MSG_cmdLike__"
    },
    "toggle-dislike": {
      "description": "__MSG_cmdDislike__"
    },
    "volume-up": {
      "description": "__MSG_cmdVolumeUp__"
    },
    "volume-down": {
      "description": "__MSG_cmdVolumeDown__"
    }
  }
}
